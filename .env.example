# Скопируйте этот файл в .env и заполните значения

# Токен бота от @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Yandex SpeechKit — для транскрибации аудио и видео
# Создаётся в Yandex Cloud: сервисный аккаунт с ролью ai.speechkit-stt.user → API ключ
YANDEX_API_KEY=your_yandex_api_key_here
# ID каталога в Yandex Cloud, виден в URL: console.cloud.yandex.ru/folders/<вот это>
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# Список разрешённых Telegram ID через запятую. Если пусто — доступ открыт всем.
# Свой ID можно узнать у бота @userinfobot
# ALLOWED_TELEGRAM_IDS=123456789,987654321
ALLOWED_TELEGRAM_IDS=

# Google Drive — ID папки в Drive, куда заливать данные пользователей.
# Создайте папку в Drive, откройте её, ID берётся из URL: drive.google.com/drive/folders/<вот это>
# Если пусто — синхронизация выключена.
GOOGLE_DRIVE_FOLDER_ID=

# Группа исследователей (Telegram Forum) — chat_id супергруппы с включёнными Topics.
# Бот пересылает сообщения респондентов в персональные темы; исследователь reply'ем
# или /ask задаёт уточняющий вопрос. Требует: бот — админ с правом Manage Topics,
# в @BotFather отключён privacy mode (/setprivacy → Disable). chat_id вида -100…
# Если пусто — функция выключена, бот работает как обычный сборщик фидбека.
RESEARCHER_GROUP_ID=
